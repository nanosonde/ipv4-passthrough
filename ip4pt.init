#!/bin/sh /etc/rc.common
# ip4pt service: loads the bridge-family nft table (if not already present),
# then runs the passive ARP discovery daemon + garbage collector.

START=95
STOP=05
USE_PROCD=1

start_service() {
	# The daemons write nft map elements into `bridge ip4pt` and GC deletes
	# from it, so the table must exist before they run. ip4pt-gen-nft creates
	# it on install and on config changes; this defensive check brings it up
	# from the rendered ruleset if it's missing (fresh install, manual nft
	# flush) -- `nft -f` is additive, so only load when the table is absent.
	OUT=/etc/ip4pt/10-ip4pt.nft
	if [ -f "$OUT" ] && ! nft list table bridge ip4pt >/dev/null 2>&1; then
		nft -f "$OUT"
	fi

	procd_open_instance ip4pt-discover
	procd_set_param command /usr/lib/ip4pt/ip4pt-discover.sh
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance ip4pt-gc
	procd_set_param command /usr/lib/ip4pt/ip4pt-gc.sh
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
