# Template for the nftables bridge-family MAC-rewrite table ip4pt. Rendered
# by /usr/bin/ip4pt-gen-nft, which substitutes @ROUTER2_MAC@, @UPLINK@ and
# @DOWNLINK@ from /etc/ip4pt/ip4pt.conf, into /etc/ip4pt/10-ip4pt.nft,
# loaded directly via `nft -f`. Don't edit the rendered copy directly; edit
# this template (or the values in ip4pt.conf) and re-run the generator instead.
#
# NOT /etc/nftables.d/: fw4 includes those files inside `table inet fw4`,
# where a full `table bridge` declaration is a syntax error that would break
# every firewall reload. A directly-loaded table lives outside fw4 and is
# untouched by fw4 reloads.
#
# ip2mac is populated/cleared at runtime by ip4pt-discover.sh / -gc.sh via
# `nft add element` / `nft delete element` -- leave it empty here.

table bridge ip4pt {
	map ip2mac {
		type ipv4_addr : ether_addr
	}

	chain postrouting {
		type filter hook postrouting priority -100; policy accept;

		# client -> FritzBox: replace the source MAC with the real client
		# MAC looked up by the frame's source IP. ip2mac is filled at runtime
		# from ARP seen on the mirror; a miss leaves the frame untouched
		# (Router2's MAC), so no NAT/translation is involved anywhere.
		oifname "@UPLINK@" ether saddr set ip saddr map @ip2mac

		# FritzBox -> client: force the destination MAC to Router2's real
		# interface MAC so its stack accepts the frame for routing onward.
		# Scoped to IPv4 by the `ip daddr` match; ARP and IPv6 pass through.
		oifname "@DOWNLINK@" ip daddr != 0.0.0.0 ether daddr set @ROUTER2_MAC@
	}
}
